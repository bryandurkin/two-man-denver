---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Site from "../../layouts/Site.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const settings = await getSiteSettings();
const seo = getSeoMeta(post, {
	siteTitle: settings?.title ?? "Two-Man Instructional Camp",
	siteUrl: Astro.url.origin,
	path: `/blog/${slug}`,
});
const published = post.data.publishedAt?.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const author = post.data.byline?.displayName;
---

<Site
	title={post.data.title}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	image={post.data.featured_image?.src}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString()}
	modifiedTime={post.data.updatedAt?.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="article">
		<div class="article__inner">
			<p class="eyebrow">{[published, author].filter(Boolean).join(" • ")}</p>
			<h1 class="article__title" {...post.edit.title}>{post.data.title}</h1>
			{
				post.data.featured_image && (
					<div class="article__image" {...post.edit.featured_image}>
						<Image image={post.data.featured_image} />
					</div>
				)
			}
			<div class="prose" {...post.edit.content}>
				<PortableText value={post.data.content} />
			</div>
			<a class="article__back" href="/blog">Back to the blog</a>
		</div>
	</article>
</Site>
