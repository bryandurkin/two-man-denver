---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Site from "../../layouts/Site.astro";

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries: posts, nextCursor, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Site title="Blog" description="Camp news and two-man mechanics from 9.01c Officials Group and 850 Officials.">
	<section class="hero page-hero">
		<div class="wrap">
			<p class="eyebrow">Camp news &amp; mechanics</p>
			<h1 class="h-hero">Blog</h1>
		</div>
	</section>

	<section class="section">
		<div class="wrap stack">
			{
				posts.length === 0 ? (
					<p class="muted">No posts yet. Check back soon.</p>
				) : (
					<div class="post-list">
						{posts.map((post) => (
							<a class="card post-card" href={`/blog/${post.id}`}>
								{post.data.featured_image && <Image image={post.data.featured_image} />}
								<p class="eyebrow">
									{post.data.publishedAt?.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
								</p>
								<h2 class="h-card">{post.data.title}</h2>
								{post.data.excerpt && <p class="muted">{post.data.excerpt}</p>}
							</a>
						))}
					</div>
				)
			}
			{nextCursor && <a class="card__link" href={`?cursor=${nextCursor}`}>Older posts</a>}
		</div>
	</section>
</Site>
