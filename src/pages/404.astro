---
import Site from "../layouts/Site.astro";
---

<Site title="Page not found" robots="noindex">
	<section class="hero page-hero">
		<div class="wrap">
			<p class="eyebrow">404</p>
			<h1 class="h-hero">Wrong call</h1>
			<p class="lead">That page doesn't exist.</p>
			<div class="btn-row" style="justify-content: center">
				<a class="tm-btn" href="/">Back to home</a>
				<a class="tm-btn tm-btn--secondary" href="/register">Register</a>
			</div>
		</div>
	</section>
</Site>
