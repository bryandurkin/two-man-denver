---
import Site from "../layouts/Site.astro";
import PriceCard from "../components/PriceCard.astro";
import Icon from "../components/Icon.astro";
import { getCamp, getDirections } from "../utils/camp";
import { clinicians } from "../data/clinicians";

const { camp, edit } = await getCamp();
const directions = getDirections(camp);
---

<Site title="Camp Details" description={`What to expect at the ${camp.title}: ${camp.dates} at ${camp.venue}, ${camp.city}.`}>
	<section class="hero page-hero">
		<div class="wrap">
			<p class="eyebrow">{camp.title}</p>
			<h1 class="h-hero">Camp Details</h1>
			<div class="tm-ribbon"><span {...edit.dates}>{camp.dates}</span></div>
			<p class="caps">{camp.venue} &bull; {camp.city}</p>
			<p class="lead" style="max-width: 720px; font-weight: 600; font-size: 20px">
				Four days. Real scenarios. Expert instruction. Build your confidence, sharpen your skills, and <span class="red">get seen</span>.
			</p>
		</div>
	</section>

	<section class="intro">
		<div class="wrap" style="max-width: 820px">
			<p class="slogan">Elevate your game. <span class="red">Earn your opportunity.</span></p>
			<p class="lead" {...edit.intro}>{camp.intro}</p>
		</div>
	</section>
	<div class="slash">
		<span class="slash__rule" aria-hidden="true"></span>
		<p>Multiple college conferences represented &amp; college coordinators in attendance</p>
		<span class="slash__rule" aria-hidden="true"></span>
	</div>

	<section class="section section--raised" id="focus">
		<div class="wrap stack">
			<div class="tm-tab"><h2>Camp focus</h2></div>
			<p class="muted" style="margin: 0; max-width: 760px">Every session is built around the skills college supervisors look for in a two-man crew.</p>
			<ul class="tm-checklist" {...edit.focus_items}>
				{
					camp.focus_items.map((item) => (
						<li>
							<Icon name="check" size={22} />
							{item.label}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" id="schedule">
		<div class="wrap stack">
			<div class="tm-tab"><h2>Four days at a glance</h2></div>
			<div class="grid-cards" {...edit.schedule}>
				{
					camp.schedule.map((day) => (
						<article class="card day-card">
							<p class="eyebrow">{day.date}</p>
							<h3 class="h-card">{day.name}</h3>
							{day.details ? (
								<p class="muted" style="white-space: pre-line">{day.details}</p>
							) : (
								<p class="placeholder">Daily schedule coming soon.</p>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--raised" id="instructors">
		<div class="wrap stack">
			<div class="tm-tab"><h2>Meet the clinicians</h2></div>
			<p class="caps" {...edit.instructors_headline}>{camp.instructors_headline}</p>
			<p class="muted" style="margin: 0" {...edit.instructors_note}>{camp.instructors_note}</p>
			<div class="clinician-list">
				{
					clinicians.map((clinician) => (
						<article class="clinician-card">
							<div class="clinician-card__photo">
								<img
									src={clinician.image}
									alt={clinician.imageAlt}
									width="260"
									height="249"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="clinician-card__body">
								<p class="eyebrow">Camp clinician</p>
								<h3 class="h-section">{clinician.name}</h3>
								<p class="clinician-card__roles">{clinician.roles.join(" · ")}</p>
								<p class="muted">{clinician.overview}</p>
								<div class="clinician-card__experience">
									{clinician.experience.map((item) => (
										<div class="clinician-card__stat">
											<strong>{item.value}</strong>
											<span>{item.label}</span>
										</div>
									))}
								</div>
								<blockquote class="clinician-card__quote">“{clinician.quote}”</blockquote>
							</div>
						</article>
					))
				}
			</div>
			{
				camp.instructor_names && (
					<div class="clinician-pending">
						<p class="eyebrow">Additional clinicians</p>
						<p class="muted" style="white-space: pre-line; margin: 0" {...edit.instructor_names}>{camp.instructor_names}</p>
						<p class="placeholder">More instructor bios coming soon.</p>
					</div>
				)
			}
			<div class="info-row" id="come-ready">
				<Icon name="mask" size={56} />
				<div class="info-row__body">
					<div class="tm-tab"><h2>Come ready to work</h2></div>
					<p class="caps" style="font-size: 22px">Bring all umpire gear</p>
					<p class="muted" {...edit.gear_note}>{camp.gear_note}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="location">
		<div class="wrap grid-split">
			<div class="stack" style="gap: 20px">
				<div class="tm-tab"><h2>Location</h2></div>
				<h3 class="h-section" style="font-size: 40px" {...edit.venue}>{camp.venue}</h3>
				<p class="location-address muted" {...(camp.address ? edit.address : edit.city)}>{camp.address || camp.city}</p>
				<p class="location-helper muted">Choose your preferred map app.</p>
				<div class="btn-row location-actions" role="group" aria-label="Directions options">
					<a class="tm-btn tm-btn--secondary" href={directions.googleMaps} target="_blank" rel="noopener noreferrer">Google Maps</a>
					<a class="tm-btn tm-btn--secondary" href={directions.appleMaps} target="_blank" rel="noopener noreferrer">Apple Maps</a>
					{camp.address && <button class="tm-btn tm-btn--secondary" type="button" data-copy-address={directions.address} hidden>Copy address</button>}
					{camp.map_url && <a class="card__link" href={camp.map_url} target="_blank" rel="noopener noreferrer">Venue map</a>}
				</div>
				<p class="location-copy-status muted" role="status" aria-live="polite" data-copy-status></p>
				{camp.location_notes && <p class="muted" style="margin: 0; white-space: pre-line" {...edit.location_notes}>{camp.location_notes}</p>}
			</div>
			<PriceCard camp={camp} edit={edit} />
		</div>
	</section>

	<script>
		const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-address]");
		const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
		if (copyButton && copyStatus && navigator.clipboard?.writeText) {
			copyButton.hidden = false;
			copyButton.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(copyButton.dataset.copyAddress || "");
					copyStatus.textContent = "Address copied.";
				} catch {
					copyStatus.textContent = "Select and copy the address above.";
				}
			});
		}
	</script>
</Site>
