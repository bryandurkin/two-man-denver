---
import Site from "../layouts/Site.astro";
import PriceCard from "../components/PriceCard.astro";
import Icon from "../components/Icon.astro";
import { getCamp } from "../utils/camp";

const { camp, edit } = await getCamp();
---

<Site title="Camp Details" description={`What to expect at the ${camp.title}: ${camp.dates} at ${camp.venue}, ${camp.city}.`}>
	<section class="hero page-hero">
		<div class="wrap">
			<p class="eyebrow">{camp.title}</p>
			<h1 class="h-hero">Camp Details</h1>
			<div class="tm-ribbon"><span {...edit.dates}>{camp.dates}</span></div>
			<p class="caps">{camp.venue} &bull; {camp.city}</p>
			<p class="lead" style="max-width: 720px; font-weight: 600; font-size: 20px">
				Four days. Real scenarios. Expert instruction. Build your confidence, sharpen your skills, and <span class="red">get seen</span>.
			</p>
		</div>
	</section>

	<section class="intro">
		<div class="wrap" style="max-width: 820px">
			<p class="slogan">Elevate your game. <span class="red">Earn your opportunity.</span></p>
			<p class="lead" {...edit.intro}>{camp.intro}</p>
		</div>
	</section>
	<div class="slash">
		<span class="slash__rule" aria-hidden="true"></span>
		<p>Multiple college conferences represented &amp; college coordinators in attendance</p>
		<span class="slash__rule" aria-hidden="true"></span>
	</div>

	<section class="section section--raised" id="focus">
		<div class="wrap stack">
			<div class="tm-tab"><h2>Camp focus</h2></div>
			<p class="muted" style="margin: 0; max-width: 760px">Every session is built around the skills college supervisors look for in a two-man crew.</p>
			<ul class="tm-checklist" {...edit.focus_items}>
				{
					camp.focus_items.map((item) => (
						<li>
							<Icon name="check" size={22} />
							{item.label}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" id="schedule">
		<div class="wrap stack">
			<div class="tm-tab"><h2>Four days at a glance</h2></div>
			<div class="grid-cards" {...edit.schedule}>
				{
					camp.schedule.map((day) => (
						<article class="card day-card">
							<p class="eyebrow">{day.date}</p>
							<h3 class="h-card">{day.name}</h3>
							{day.details ? (
								<p class="muted" style="white-space: pre-line">{day.details}</p>
							) : (
								<p class="placeholder">Daily schedule coming soon.</p>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--raised">
		<div class="wrap grid-split">
			<div class="info-row" id="instructors">
				<Icon name="mask" size={56} />
				<div class="info-row__body">
					<div class="tm-tab"><h2>Instructors</h2></div>
					<p class="caps" style="font-size: 22px" {...edit.instructors_headline}>{camp.instructors_headline}</p>
					<p class="muted" style="font-style: italic" {...edit.instructors_note}>{camp.instructors_note}</p>
					{
						camp.instructor_names && (
							<p class="muted" style="white-space: pre-line" {...edit.instructor_names}>{camp.instructor_names}</p>
						)
					}
					<p class="placeholder">{camp.instructor_names ? "Instructor bios coming soon." : "Instructor names and bios coming soon."}</p>
				</div>
			</div>
			<div class="info-row" id="come-ready">
				<Icon name="mask" size={56} />
				<div class="info-row__body">
					<div class="tm-tab"><h2>Come ready to work</h2></div>
					<p class="caps" style="font-size: 22px">Bring all umpire gear</p>
					<p class="muted" {...edit.gear_note}>{camp.gear_note}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="location">
		<div class="wrap grid-split">
			<div class="stack" style="gap: 20px">
				<div class="tm-tab"><h2>Location</h2></div>
				<h3 class="h-section" style="font-size: 40px" {...edit.venue}>{camp.venue}</h3>
				<p class="caps muted" {...edit.city}>{camp.city}</p>
				{
					camp.map_url ? (
						<a class="tm-btn tm-btn--secondary" style="align-self: flex-start" href={camp.map_url} target="_blank" rel="noopener">
							Get directions
						</a>
					) : (
						<div class="map-box">
							<p class="placeholder" style="margin: 0">Map and directions coming soon.</p>
						</div>
					)
				}
				{camp.location_notes && <p class="muted" style="margin: 0; white-space: pre-line" {...edit.location_notes}>{camp.location_notes}</p>}
			</div>
			<PriceCard camp={camp} edit={edit} />
		</div>
	</section>
</Site>
